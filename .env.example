VITE_GA_MEASUREMENT_ID=

# Google Search Console Verification Code  
# احصل عليه من: https://search.google.com/search-console/
# مثال: abcdefghijklmnopqrstuvwxyz1234567890
VITE_GSC_VERIFICATION=

# معلومات الموقع
